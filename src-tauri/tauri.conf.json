{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidExtract",
  "version": "2.3.0",
  "identifier": "com.ekrembulgan.vidextract",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VidExtract Studio",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Videoyu indir, konuşmaları ara, istediğin ana ulaş.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-pulseaudio"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Ekrem Bulgan",
    "copyright": "Copyright © 2026 Ekrem Bulgan",
    "homepage": "https://github.com/idginity124/VidExtract",
    "license": "GPL-3.0-only"
  }
}
